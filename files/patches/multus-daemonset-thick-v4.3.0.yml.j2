---
# Strategic-merge patch for the checksum-pinned Multus v4.3.0 thick manifest.
# A Multus version update requires a new reviewed patch and checksum.
#
# Host netns must be visible at both /run/netns and /var/run/netns inside the
# thick daemon. containerd reports CNI_NETNS=/var/run/netns/cni-*, but the
# Multus image has a real /var/run directory (not a symlink to /run), so a
# /run/netns mount alone makes DelegateAdd Statfs fail with validateIfName.
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: kube-multus-ds
  namespace: kube-system
spec:
  template:
    spec:
      initContainers:
        - name: install-multus-binary
          image: {{ multus_image }}
          imagePullPolicy: IfNotPresent
          command:
            - /usr/src/multus-cni/bin/install_multus
            - -d
            - /host/opt/cni/bin
            - -t
            - thick
          securityContext:
            privileged: true
          volumeMounts:
            - name: cnibin
              mountPath: /host/opt/cni/bin
      containers:
        - name: kube-multus
          image: {{ multus_image }}
          imagePullPolicy: IfNotPresent
          command:
            - /usr/src/multus-cni/bin/multus-daemon
          securityContext:
            privileged: true
          env:
            - name: MULTUS_NODE_NAME
              valueFrom:
                fieldRef:
                  apiVersion: v1
                  fieldPath: spec.nodeName
          volumeMounts:
            - name: multus-daemon-config
              mountPath: /etc/cni/net.d/multus.d
              readOnly: true
            - name: cni
              mountPath: /host/etc/cni/net.d
            - name: host-run
              mountPath: /host/run
            - name: hostroot
              mountPath: /hostroot
              mountPropagation: HostToContainer
            - name: cnibin
              mountPath: /opt/cni/bin
            - name: host-run-k8s-cni-cncf-io
              mountPath: /run/k8s.cni.cncf.io
            - name: host-run-netns
              mountPath: /run/netns
              mountPropagation: HostToContainer
            - name: host-var-run-netns
              mountPath: /var/run/netns
              mountPropagation: HostToContainer
            - name: host-var-lib-cni-multus
              mountPath: /var/lib/cni/multus
            - name: host-var-lib-kubelet
              mountPath: /var/lib/kubelet
              mountPropagation: HostToContainer
          resources:
            requests:
              cpu: 200m
              memory: 100Mi
      volumes:
        - name: cni
          hostPath:
            path: /etc/cni/net.d
        - name: cnibin
          hostPath:
            path: /opt/cni/bin
        - name: hostroot
          hostPath:
            path: /
        - name: multus-daemon-config
          configMap:
            name: multus-daemon-config
        - name: host-run
          hostPath:
            path: /run
        - name: host-var-lib-cni-multus
          hostPath:
            path: /var/lib/cni/multus
        - name: host-var-lib-kubelet
          hostPath:
            path: /var/lib/kubelet
        - name: host-run-k8s-cni-cncf-io
          hostPath:
            path: /run/k8s.cni.cncf.io
        - name: host-run-netns
          hostPath:
            path: /run/netns/
        - name: host-var-run-netns
          hostPath:
            path: /var/run/netns/
